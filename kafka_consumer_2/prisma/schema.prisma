generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GroupMessages {
  id           Int            @id @default(autoincrement())
  projectId    Int
  message      String
  fileLink     String?        @db.VarChar
  senderId     Int
  timeStamp    String         @db.VarChar
  Projects     Projects       @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users        users          @relation(fields: [senderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  UserMessages UserMessages[]

  @@index([id], map: "ix_GroupMessages_id")
}

model IndividualMessage {
  id                      Int                       @id @default(autoincrement())
  projectId               Int
  channelId               String                    @db.VarChar
  senderId                Int
  message                 String?                   @db.VarChar
  Link                    String?                   @db.VarChar
  isDeleted               Boolean?
  timeStamp               String                    @db.VarChar
  Channels                Channels                  @relation(fields: [channelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Projects                Projects                  @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                   users                     @relation(fields: [senderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  IndividualMessageStatus IndividualMessageStatus[]

  @@index([id], map: "ix_IndividualMessage_id")
  @@index([channelId], map: "ix_IndividualMessage_channelId")
}

model IndividualMessageStatus {
  id                Int               @id @default(autoincrement())
  messageId         Int
  receiverId        Int
  isMessageSeen     Boolean?
  isReceived        Boolean?
  isDelevered       Boolean?
  timeStamp         String            @db.VarChar
  IndividualMessage IndividualMessage @relation(fields: [messageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users             users             @relation(fields: [receiverId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_IndividualMessageStatus_id")
  @@index([messageId], map: "ix_IndividualMessageStatus_messageId")
  @@index([receiverId], map: "ix_IndividualMessageStatus_receiverId")
}

model ProjectMembers {
  id          Int      @id @default(autoincrement())
  phonenumber String   @db.VarChar
  projectId   Int
  userId      Int
  Projects    Projects @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users       users    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_ProjectMembers_id")
}

model Projects {
  id                 Int                 @id @default(autoincrement())
  projectName        String              @db.VarChar
  managerId          Int
  projectDiscription String              @db.VarChar
  projectStatus      statusenum
  projectStartDate   String              @db.VarChar
  projectEndDate     String              @db.VarChar
  isFeedBackeOpen    Boolean?
  isDeleted          Boolean?
  GroupMessages      GroupMessages[]
  IndividualMessage  IndividualMessage[]
  ProjectMembers     ProjectMembers[]
  users              users               @relation(fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  UserFeedBack       UserFeedBack[]
  UserMessages       UserMessages[]
  managerFeedBack    managerFeedBack[]
  tiggerfeedback     tiggerfeedback[]

  @@index([id], map: "ix_Projects_id")
}

model UserFeedBack {
  id        Int       @id @default(autoincrement())
  projectId Int?
  message   String    @db.VarChar
  rating    Int
  senderId  Int
  timeStamp String    @db.VarChar
  Projects  Projects? @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users     users     @relation(fields: [senderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([projectId, senderId], map: "uix_project_employee_feedback")
  @@index([id], map: "ix_UserFeedBack_id")
  @@index([projectId], map: "ix_UserFeedBack_projectId")
}

model UserMessages {
  id            Int           @id @default(autoincrement())
  projectId     Int
  messageId     Int
  receiverId    Int
  timeStamp     String        @db.VarChar
  isMessageSeen Boolean?
  isReceived    Boolean?
  isDelevered   Boolean?
  GroupMessages GroupMessages @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Projects      Projects      @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users         users         @relation(fields: [receiverId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_UserMessages_id")
}

model managerFeedBack {
  id                    Int      @id @default(autoincrement())
  projectId             Int
  project_delivery      Int
  receiverId            Int
  work_accuracy         Int
  team_collaboration    Int
  areas_for_improvement String   @db.VarChar
  description           String   @db.VarChar
  timeStamp             String   @db.VarChar
  Projects              Projects @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                 users    @relation(fields: [receiverId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([projectId, receiverId], map: "uix_project_manager_feedback")
  @@index([id], map: "ix_managerFeedBack_id")
}

model roles {
  id         Int          @id @default(autoincrement())
  name       String       @db.VarChar
  user_roles user_roles[]
}

model user_roles {
  user_id     Int
  role_id     Int
  assigned_at String @db.VarChar
  roles       roles  @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users       users  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, role_id])
}

model users {
  id                      Int                       @id @default(autoincrement())
  username                String                    @db.VarChar
  mobilenumber            String?                   @db.VarChar
  emailId                 String?                   @unique(map: "ix_users_emailId") @db.VarChar
  picture                 String?                   @db.VarChar
  password                String                    @db.VarChar
  GroupMessages           GroupMessages[]
  IndividualMessage       IndividualMessage[]
  IndividualMessageStatus IndividualMessageStatus[]
  Members                 Members[]
  ProjectMembers          ProjectMembers[]
  Projects                Projects[]
  UserFeedBack            UserFeedBack[]
  UserMessages            UserMessages[]
  managerFeedBack         managerFeedBack[]
  user_roles              user_roles[]

  @@index([id], map: "ix_users_id")
}

model Channels {
  id                String              @id @db.VarChar
  IndividualMessage IndividualMessage[]
  Members           Members[]

  @@index([id], map: "ix_Channels_id")
}

model Members {
  id        Int      @id @default(autoincrement())
  userId    Int
  channelId String   @db.VarChar
  Channels  Channels @relation(fields: [channelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users     users    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([channelId], map: "ix_Members_channelId")
  @@index([id], map: "ix_Members_id")
}

model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}

model tiggerfeedback {
  id             Int      @id @default(autoincrement())
  isFeedBackOpen Boolean?
  projectId      Int
  Projects       Projects @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_tiggerfeedback_id")
}

enum statusenum {
  NOT_STARTED
  PENDING
  IN_PROGRESS
  COMPLETED
}
